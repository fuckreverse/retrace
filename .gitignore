# Retrace monorepo — build artifacts, caches, and runtime outputs

# dashcam (recorder) build directories, deps cache, and build artifacts
dashcam/build/
dashcam/build-*/
dashcam/_deps/
libqbditrace.dylib
libqbditrace.so
libqbditrace_stripped.dylib

# slowmo (analyzer) standalone build directories and runtime cache
slowmo/build/
slowmo/build-*/
slowmo/demo/.tenet_cache_*/
slowmo/.cache/
slowmo/imgui.ini
slowmo/_deps/
slowmo/tests/traces/
**/.tenet_cache_*/

# slowmo web (Vite + React + Tauri) build artifacts and deps
slowmo/web/node_modules/
slowmo/web/dist/
slowmo/web/tsconfig.tsbuildinfo
slowmo/web/src-tauri/target/
slowmo/web/src-tauri/gen/schemas/
# sidecar binary + bundled third-party dylibs, regenerated by
# slowmo/web/src-tauri/scripts/prepare-sidecar.sh (platform-specific, large)
slowmo/web/src-tauri/binaries/

# patched QBDI clone, per-platform build trees and static libs
# (produced by scripts/prepare-qbdi.sh) — anchored to repo root so the
# vendored license texts under slowmo/web/src-tauri/licenses/third-party/
# stay tracked
/third-party/

# Tenet product website: dependencies, generated output, local config, and test artifacts
website/node_modules/
website/dist/
website/.astro/
website/.wrangler/
website/.env
website/.env.*
!website/.env.example
website/coverage/
website/playwright-report/
website/test-results/

# trace files
*.bin

# misc
**/.DS_Store
TODO
__pycache__
*.pyc
*.pyo
*.egg-info
