{
  "_comment": "bnCode VMP (Ctrip) bytecode decoder for tenet. Translated from decoder.py.",
  "name": "bncode_v1",
  "word_size": 4,
  "registers": {"prefix": "R", "count": 32},
  "default_op": "NOP",

  "extract_templates": {
    "_doc": "Reusable bit-field extraction pipelines, referenced by name in operands.",

    "fmt_a_dst": [
      {"op":"lsr_and","lsr":7,"and":"0xC"},{"op":"or_accum"},
      {"op":"lsr_and","lsr":19,"and":"0x3"},{"op":"or_accum"},
      {"op":"lsr_and","lsr":11,"and":"0x10"},{"op":"or_accum"},
      {"op":"and","imm":"0x1F"}
    ],
    "fmt_a_src1": [
      {"op":"lsr_and","lsr":4,"and":"0xC"},{"op":"or_accum"},
      {"op":"lsr_and","lsr":11,"and":"0x3"},{"op":"or_accum"},
      {"op":"lsr_and","lsr":12,"and":"0x10"},{"op":"or_accum"},
      {"op":"and","imm":"0x1F"}
    ],
    "fmt_a_src2": [
      {"op":"lsr_and","lsr":11,"and":"0xC"},{"op":"or_accum"},
      {"op":"lsr_and","lsr":17,"and":"0x3"},{"op":"or_accum"},
      {"op":"lsr_and","lsr":4,"and":"0x10"},{"op":"or_accum"},
      {"op":"and","imm":"0x1F"}
    ],

    "fmt_c_rt": [
      {"op":"and","imm":"0x3"},{"op":"or_accum"},
      {"op":"lsr_and","lsr":14,"and":"0xC"},{"op":"or_accum"},
      {"op":"lsr_and","lsr":4,"and":"0x10"},{"op":"or_accum"},
      {"op":"and","imm":"0x1F"}
    ],
    "fmt_c_base": [
      {"op":"lsr_and","lsr":17,"and":"0xC"},{"op":"or_accum"},
      {"op":"lsr_and","lsr":9,"and":"0x3"},{"op":"or_accum"},
      {"op":"lsr","imm":2},{"op":"and","imm":"0x1"},{"op":"lsl","imm":4},{"op":"or_accum"},
      {"op":"and","imm":"0x1F"}
    ],
    "fmt_c_off16": [
      {"op":"lsr_and","lsr":11,"and":"0x1F"},{"op":"or_accum"},
      {"op":"lsr_and","lsr":18,"and":"0xE0"},{"op":"or_accum"},
      {"op":"lsr_and","lsr":10,"and":"0x700"},{"op":"or_accum"},
      {"op":"lsr","imm":3},{"op":"and","imm":"0x1F"},{"op":"lsl","imm":11},{"op":"or_accum"},
      {"op":"and","imm":"0xFFFF"},{"op":"sext","width":16}
    ],
    "fmt_c_off16_x4": [
      {"op":"lsr_and","lsr":11,"and":"0x1F"},{"op":"or_accum"},
      {"op":"lsr_and","lsr":18,"and":"0xE0"},{"op":"or_accum"},
      {"op":"lsr_and","lsr":10,"and":"0x700"},{"op":"or_accum"},
      {"op":"lsr","imm":3},{"op":"and","imm":"0x1F"},{"op":"lsl","imm":11},{"op":"or_accum"},
      {"op":"and","imm":"0xFFFF"},{"op":"sext","width":16},{"op":"mul","imm":4}
    ],

    "fmt_d_reg": [
      {"op":"and","imm":"0x3"},{"op":"or_accum"},
      {"op":"lsr_and","lsr":14,"and":"0xC"},{"op":"or_accum"},
      {"op":"lsr_and","lsr":4,"and":"0x10"},{"op":"or_accum"},
      {"op":"and","imm":"0x1F"}
    ],
    "fmt_d_off11_x4": [
      {"op":"and","imm":"0x7FF"},{"op":"mul","imm":4}
    ],

    "fmt_b_ra":    [{"op":"lsr","imm":21},{"op":"and","imm":"0x1F"}],
    "fmt_b_rb":    [{"op":"lsr","imm":16},{"op":"and","imm":"0x1F"}],
    "fmt_b_rc":    [{"op":"lsr","imm":11},{"op":"and","imm":"0x1F"}],
    "fmt_b_shift": [{"op":"lsr","imm":6},{"op":"and","imm":"0x3F"}],
    "fmt_b_sh5":   [{"op":"lsr","imm":6},{"op":"and","imm":"0x1F"}],
    "imm16_sext":  [{"op":"and","imm":"0xFFFF"},{"op":"sext","width":16}],
    "imm16_raw":   [{"op":"and","imm":"0xFFFF"}],
    "rel26_x4":    [{"op":"and","imm":"0x3FFFFFF"},{"op":"sext","width":26},{"op":"mul","imm":4}]
  },

  "routing": [
    {"_": "=== Level 1: Primary (W8 = word & 0xFFE0003F) ==="},

    {"mask":"0xFFE0003F","match":"0x20","op":"ASR_REG","format":"{d}, {s1}, {s2}",
     "operands":{"d":{"type":"vm_reg","extract":"fmt_a_dst"},"s1":{"type":"vm_reg","extract":"fmt_a_src1"},"s2":{"type":"vm_reg","extract":"fmt_a_src2"}}},
    {"mask":"0xFFE0003F","match":"0x24","op":"NOR","format":"{d}, {s1}, {s2}",
     "operands":{"d":{"type":"vm_reg","extract":"fmt_a_dst"},"s1":{"type":"vm_reg","extract":"fmt_a_src1"},"s2":{"type":"vm_reg","extract":"fmt_a_src2"}}},
    {"mask":"0xFFE0003F","match":"0x37","op":"XOR","format":"{d}, {s1}, {s2}",
     "operands":{"d":{"type":"vm_reg","extract":"fmt_a_dst"},"s1":{"type":"vm_reg","extract":"fmt_a_src1"},"s2":{"type":"vm_reg","extract":"fmt_a_src2"}}},
    {"mask":"0xFFE0003F","match":"0x35","op":"ORR","format":"{d}, {s1}, {s2}",
     "operands":{"d":{"type":"vm_reg","extract":"fmt_a_dst"},"s1":{"type":"vm_reg","extract":"fmt_a_src1"},"s2":{"type":"vm_reg","extract":"fmt_a_src2"}}},
    {"mask":"0xFFE0003F","match":"0x2B","op":"LSL_REG","format":"{d}, {s1}, {s2}",
     "operands":{"d":{"type":"vm_reg","extract":"fmt_a_dst"},"s1":{"type":"vm_reg","extract":"fmt_a_src1"},"s2":{"type":"vm_reg","extract":"fmt_a_src2"}}},
    {"mask":"0xFFE0003F","match":"0x2A","op":"LSR_REG","format":"{d}, {s1}, {s2}",
     "operands":{"d":{"type":"vm_reg","extract":"fmt_a_dst"},"s1":{"type":"vm_reg","extract":"fmt_a_src1"},"s2":{"type":"vm_reg","extract":"fmt_a_src2"}}},
    {"mask":"0xFFE0003F","match":"0x27","op":"AND","format":"{d}, {s1}, {s2}",
     "operands":{"d":{"type":"vm_reg","extract":"fmt_a_dst"},"s1":{"type":"vm_reg","extract":"fmt_a_src1"},"s2":{"type":"vm_reg","extract":"fmt_a_src2"}}},
    {"mask":"0xFFE0003F","match":"0x04","op":"SUB","format":"{d}, {s1}, {s2}",
     "operands":{"d":{"type":"vm_reg","extract":"fmt_a_dst"},"s1":{"type":"vm_reg","extract":"fmt_a_src1"},"s2":{"type":"vm_reg","extract":"fmt_a_src2"}}},
    {"mask":"0xFFE0003F","match":"0x0B","op":"SUB","format":"{d}, {s1}, {s2}",
     "operands":{"d":{"type":"vm_reg","extract":"fmt_a_dst"},"s1":{"type":"vm_reg","extract":"fmt_a_src1"},"s2":{"type":"vm_reg","extract":"fmt_a_src2"}}},
    {"mask":"0xFFE0003F","match":"0x06","op":"CMP_LT","format":"{d}, {s1}, {s2}",
     "operands":{"d":{"type":"vm_reg","extract":"fmt_a_dst"},"s1":{"type":"vm_reg","extract":"fmt_a_src1"},"s2":{"type":"vm_reg","extract":"fmt_a_src2"}}},
    {"mask":"0xFFE0003F","match":"0x22","op":"CMP_CC","format":"{d}, {s1}, {s2}",
     "operands":{"d":{"type":"vm_reg","extract":"fmt_a_dst"},"s1":{"type":"vm_reg","extract":"fmt_a_src1"},"s2":{"type":"vm_reg","extract":"fmt_a_src2"}}},
    {"mask":"0xFFE0003F","match":"0x0A","op":"MOVZ","format":"{d}, {s1}, {s2}",
     "operands":{"d":{"type":"vm_reg","extract":"fmt_a_dst"},"s1":{"type":"vm_reg","extract":"fmt_a_src1"},"s2":{"type":"vm_reg","extract":"fmt_a_src2"}}},

    {"_":"Branches"},
    {"mask":"0xFFE0003F","match":"0x23","op":"CBNZ","format":"{r}, {off}",
     "operands":{"r":{"type":"vm_reg","extract":"fmt_d_reg"},"off":{"type":"imm_hex","extract":"fmt_d_off11_x4"}}},
    {"mask":"0xFFE0003F","match":"0x21","op":"CBZ","format":"{r}, {off}",
     "operands":{"r":{"type":"vm_reg","extract":"fmt_d_reg"},"off":{"type":"imm_hex","extract":"fmt_d_off11_x4"}}},
    {"mask":"0xFFE0003F","match":"0x25","op":"CBNZ_EXT","format":"{r}, {off}",
     "operands":{"r":{"type":"vm_reg","extract":"fmt_d_reg"},"off":{"type":"imm_hex","extract":"fmt_d_off11_x4"}}},
    {"mask":"0xFFE0003F","match":"0x26","op":"CBZ_EXT","format":"{r}, {off}",
     "operands":{"r":{"type":"vm_reg","extract":"fmt_d_reg"},"off":{"type":"imm_hex","extract":"fmt_d_off11_x4"}}},
    {"mask":"0xFFE0003F","match":"0x2E","op":"BR_NEG","format":"{r}, {off}",
     "operands":{"r":{"type":"vm_reg","extract":"fmt_d_reg"},"off":{"type":"imm_hex","extract":"fmt_d_off11_x4"}}},
    {"mask":"0xFFE0003F","match":"0x29","op":"BR_GT0","format":"{r}, {off}",
     "operands":{"r":{"type":"vm_reg","extract":"fmt_d_reg"},"off":{"type":"imm_hex","extract":"fmt_d_off11_x4"}}},
    {"mask":"0xFFE0003F","match":"0x28","op":"BR_GE1","format":"{r}, {off}",
     "operands":{"r":{"type":"vm_reg","extract":"fmt_d_reg"},"off":{"type":"imm_hex","extract":"fmt_d_off11_x4"}}},
    {"mask":"0xFFE0003F","match":"0x3A","op":"B","format":"{off}",
     "operands":{"off":{"type":"branch_rel","extract":"rel26_x4"}}},

    {"_":"MOV_IMM16 (W8=0x0F)"},
    {"mask":"0xFFE0003F","match":"0x0F","op":"MOV_IMM16","format":"{d}, {imm}",
     "operands":{"d":{"type":"vm_reg","extract":"fmt_b_rb"},"imm":{"type":"imm_hex","extract":"imm16_raw"}}},

    {"_":"SRL (W8=0x02)"},
    {"mask":"0xFFE0003F","match":"0x02","op":"SRL","format":"{d}, {s}, {sh}",
     "operands":{"d":{"type":"vm_reg","extract":"fmt_b_rc"},"s":{"type":"vm_reg","extract":"fmt_b_rb"},"sh":{"type":"imm","extract":"fmt_b_sh5"}}},
    {"_":"SRA (W8=0x03)"},
    {"mask":"0xFFE0003F","match":"0x03","op":"SRA","format":"{d}, {s}, {sh}",
     "operands":{"d":{"type":"vm_reg","extract":"fmt_b_rc"},"s":{"type":"vm_reg","extract":"fmt_b_rb"},"sh":{"type":"imm","extract":"fmt_b_sh5"}}},

    {"_":"ROR_SHIFT (W8=0x200002)"},
    {"mask":"0xFFE0003F","match":"0x200002","op":"ROR","format":"{d}, {s}, {sh}",
     "operands":{"d":{"type":"vm_reg","extract":"fmt_b_rc"},"s":{"type":"vm_reg","extract":"fmt_b_rb"},"sh":{"type":"imm","extract":"fmt_b_shift"}}},

    {"_":"=== Level 2: Secondary masks ==="},
    {"mask":"0xFC0207FF","match":"0x1","op":"NOP","format":""},
    {"mask":"0xFC00073F","match":"0x5","op":"SCALED_ADD","format":"{d}, {s1}, {s2}, {sh}",
     "operands":{"d":{"type":"vm_reg","extract":"fmt_b_ra"},"s1":{"type":"vm_reg","extract":"fmt_b_rb"},"s2":{"type":"vm_reg","extract":"fmt_b_rc"},"sh":{"type":"imm","extract":[{"op":"lsr","imm":6},{"op":"and","imm":"0x3"}]}}},
    {"mask":"0xFC1FF83F","match":"0x8","op":"BR_IND","format":"{r}",
     "operands":{"r":{"type":"vm_reg","extract":"fmt_b_ra"}}},
    {"mask":"0xFC1F003F","match":"0x9","op":"CALL_REL","format":"{link}",
     "operands":{"link":{"type":"vm_reg","extract":"fmt_b_ra"}}},
    {"mask":"0xFC00003F","match":"0xC","op":"FFI_CALL","format":"{id}",
     "operands":{"id":{"type":"imm_hex","extract":[{"op":"lsr","imm":6},{"op":"and","imm":"0xFFFFF"}]}}},
    {"mask":"0xFFFF07FF","match":"0x12","op":"LD_AUX64","format":"{r}",
     "operands":{"r":{"type":"vm_reg","extract":"fmt_b_rc"}}},
    {"mask":"0x7FF","match":"0x2","op":"MUL","format":"{d}, {s1}, {s2}",
     "operands":{"d":{"type":"vm_reg","extract":"fmt_b_rc"},"s1":{"type":"vm_reg","extract":"fmt_b_ra"},"s2":{"type":"vm_reg","extract":"fmt_b_rb"}}},
    {"mask":"0xFC00FFFF","match":"0x18","op":"SMULL","format":"{d}, {s}",
     "operands":{"d":{"type":"vm_reg","extract":"fmt_b_ra"},"s":{"type":"vm_reg","extract":"fmt_b_rb"}}},
    {"mask":"0xFC00FFFF","match":"0x19","op":"SMULL","format":"{d}, {s}",
     "operands":{"d":{"type":"vm_reg","extract":"fmt_b_ra"},"s":{"type":"vm_reg","extract":"fmt_b_rb"}}},
    {"mask":"0xFC00FFFF","match":"0x1A","op":"DIVMOD","format":"{d}, {s}",
     "operands":{"d":{"type":"vm_reg","extract":"fmt_b_ra"},"s":{"type":"vm_reg","extract":"fmt_b_rb"}}},
    {"mask":"0xFC00FFFF","match":"0x1B","op":"DIVMOD","format":"{d}, {s}",
     "operands":{"d":{"type":"vm_reg","extract":"fmt_b_ra"},"s":{"type":"vm_reg","extract":"fmt_b_rb"}}},
    {"mask":"0xFFE0003F","match":"0x10","op":"LD_FLAGS","format":"{r}",
     "operands":{"r":{"type":"vm_reg","extract":"fmt_b_rc"}}},

    {"_":"=== Level 3: Tertiary (bits[31:26]) ==="},
    {"_":"Shift-by-immediate (Format B)"},
    {"mask":"0xFC00003F","match":"0x0","op":"LSL_SHIFT","format":"{d}, {s}, {sh}",
     "operands":{"d":{"type":"vm_reg","extract":"fmt_b_rc"},"s":{"type":"vm_reg","extract":"fmt_b_rb"},"sh":{"type":"imm","extract":"fmt_b_shift"}}},
    {"mask":"0xFC000000","match":"0x08000000","op":"LSR_SHIFT","format":"{d}, {s}, {sh}",
     "operands":{"d":{"type":"vm_reg","extract":"fmt_b_rc"},"s":{"type":"vm_reg","extract":"fmt_b_rb"},"sh":{"type":"imm","extract":"fmt_b_shift"}}},
    {"mask":"0xFC000000","match":"0x0C000000","op":"ASR_SHIFT","format":"{d}, {s}, {sh}",
     "operands":{"d":{"type":"vm_reg","extract":"fmt_b_rc"},"s":{"type":"vm_reg","extract":"fmt_b_rb"},"sh":{"type":"imm","extract":"fmt_b_shift"}}},

    {"_":"Memory ops (Format C)"},
    {"mask":"0xFC000000","match":"0x04000000","op":"STRH","format":"{rt}, [{base}+{off}]",
     "operands":{"rt":{"type":"vm_reg","extract":"fmt_c_rt"},"base":{"type":"vm_reg","extract":"fmt_c_base"},"off":{"type":"imm_signed","extract":"fmt_c_off16"}}},
    {"mask":"0xFC000000","match":"0x10000000","op":"STR","format":"{rt}, [{base}+{off}]",
     "operands":{"rt":{"type":"vm_reg","extract":"fmt_c_rt"},"base":{"type":"vm_reg","extract":"fmt_c_base"},"off":{"type":"imm_signed","extract":"fmt_c_off16"}}},
    {"mask":"0xFC000000","match":"0x14000000","op":"LDR","format":"{rt}, [{base}+{off}]",
     "operands":{"rt":{"type":"vm_reg","extract":"fmt_c_rt"},"base":{"type":"vm_reg","extract":"fmt_c_base"},"off":{"type":"imm_signed","extract":"fmt_c_off16"}}},
    {"mask":"0xFC000000","match":"0x18000000","op":"STRH","format":"{rt}, [{base}+{off}]",
     "operands":{"rt":{"type":"vm_reg","extract":"fmt_c_rt"},"base":{"type":"vm_reg","extract":"fmt_c_base"},"off":{"type":"imm_signed","extract":"fmt_c_off16"}}},
    {"mask":"0xFC000000","match":"0x1C000000","op":"STRB","format":"{rt}, [{base}+{off}]",
     "operands":{"rt":{"type":"vm_reg","extract":"fmt_c_rt"},"base":{"type":"vm_reg","extract":"fmt_c_base"},"off":{"type":"imm_signed","extract":"fmt_c_off16"}}},
    {"mask":"0xFC000000","match":"0x28000000","op":"LDRH","format":"{rt}, [{base}+{off}]",
     "operands":{"rt":{"type":"vm_reg","extract":"fmt_c_rt"},"base":{"type":"vm_reg","extract":"fmt_c_base"},"off":{"type":"imm_signed","extract":"fmt_c_off16"}}},
    {"mask":"0xFC000000","match":"0x2C000000","op":"LDRB","format":"{rt}, [{base}+{off}]",
     "operands":{"rt":{"type":"vm_reg","extract":"fmt_c_rt"},"base":{"type":"vm_reg","extract":"fmt_c_base"},"off":{"type":"imm_signed","extract":"fmt_c_off16"}}},
    {"mask":"0xFC000000","match":"0x30000000","op":"LDR","format":"{rt}, [{base}+{off}]",
     "operands":{"rt":{"type":"vm_reg","extract":"fmt_c_rt"},"base":{"type":"vm_reg","extract":"fmt_c_base"},"off":{"type":"imm_signed","extract":"fmt_c_off16"}}},
    {"mask":"0xFC000000","match":"0x34000000","op":"LDR_COMPOSITE","format":"{rt}, [{base}+{off}]",
     "operands":{"rt":{"type":"vm_reg","extract":"fmt_c_rt"},"base":{"type":"vm_reg","extract":"fmt_c_base"},"off":{"type":"imm_signed","extract":"fmt_c_off16"}}},
    {"mask":"0xFC000000","match":"0x38000000","op":"LDRSB","format":"{rt}, [{base}+{off}]",
     "operands":{"rt":{"type":"vm_reg","extract":"fmt_c_rt"},"base":{"type":"vm_reg","extract":"fmt_c_base"},"off":{"type":"imm_signed","extract":"fmt_c_off16"}}},
    {"mask":"0xFC000000","match":"0xAC000000","op":"STRH","format":"{rt}, [{base}+{off}]",
     "operands":{"rt":{"type":"vm_reg","extract":"fmt_c_rt"},"base":{"type":"vm_reg","extract":"fmt_c_base"},"off":{"type":"imm_signed","extract":"fmt_c_off16"}}},

    {"_":"ALU with immediate (Format C-var / B-var)"},
    {"mask":"0xFC000000","match":"0x24000000","op":"ADD_IMM","format":"{d}, {s}, {imm}",
     "operands":{"d":{"type":"vm_reg","extract":"fmt_b_rc"},"s":{"type":"vm_reg","extract":"fmt_b_rb"},"imm":{"type":"imm_signed","extract":"imm16_sext"}}},
    {"mask":"0xFC000000","match":"0x80000000","op":"XOR_IMM","format":"{d}, {s}, {imm}",
     "operands":{"d":{"type":"vm_reg","extract":"fmt_c_rt"},"s":{"type":"vm_reg","extract":"fmt_c_base"},"imm":{"type":"imm_signed","extract":"fmt_c_off16"}}},
    {"mask":"0xFC000000","match":"0x88000000","op":"ORR_IMM","format":"{d}, {s}, {imm}",
     "operands":{"d":{"type":"vm_reg","extract":"fmt_c_rt"},"s":{"type":"vm_reg","extract":"fmt_c_base"},"imm":{"type":"imm_signed","extract":"fmt_c_off16"}}},
    {"mask":"0xFC000000","match":"0x8C000000","op":"AND_IMM","format":"{d}, {s}, {imm}",
     "operands":{"d":{"type":"vm_reg","extract":"fmt_c_rt"},"s":{"type":"vm_reg","extract":"fmt_c_base"},"imm":{"type":"imm_signed","extract":"fmt_c_off16"}}},
    {"mask":"0xFC000000","match":"0x90000000","op":"CMP_CC_IMM","format":"{d}, {s}, {imm}",
     "operands":{"d":{"type":"vm_reg","extract":"fmt_c_rt"},"s":{"type":"vm_reg","extract":"fmt_c_base"},"imm":{"type":"imm_signed","extract":"fmt_c_off16"}}},
    {"mask":"0xFC000000","match":"0x94000000","op":"CMP_LT_IMM","format":"{d}, {s}, {imm}",
     "operands":{"d":{"type":"vm_reg","extract":"fmt_c_rt"},"s":{"type":"vm_reg","extract":"fmt_c_base"},"imm":{"type":"imm_signed","extract":"fmt_c_off16"}}},
    {"mask":"0xFC000000","match":"0x98000000","op":"ADD_IMM","format":"{d}, {s}, {imm}",
     "operands":{"d":{"type":"vm_reg","extract":"fmt_c_rt"},"s":{"type":"vm_reg","extract":"fmt_c_base"},"imm":{"type":"imm_signed","extract":"fmt_c_off16"}}},

    {"_":"Pair branches"},
    {"mask":"0xFC000000","match":"0x20000000","op":"BNE_PAIR","format":"{r}, {off}",
     "operands":{"r":{"type":"vm_reg","extract":"fmt_d_reg"},"off":{"type":"imm_signed","extract":"fmt_c_off16_x4"}}},
    {"mask":"0xFC000000","match":"0xA8000000","op":"BEQ_PAIR","format":"{r}, {off}",
     "operands":{"r":{"type":"vm_reg","extract":"fmt_d_reg"},"off":{"type":"imm_signed","extract":"fmt_c_off16_x4"}}},

    {"_":"ADD via b26 secondary"},
    {"mask":"0xFC000000","match":"0x3C000000","op":"MOV_IMM16","format":"{d}, {imm}",
     "operands":{"d":{"type":"vm_reg","extract":"fmt_b_rb"},"imm":{"type":"imm_hex","extract":"imm16_raw"}}}
  ]
}
