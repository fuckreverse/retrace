{
  "name": "tenet-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web frontend for tenet — QBDI trace offline analyzer (Feixiang-style UI)",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --open /?mock=1",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx",
    "tauri": "tauri",
    "sidecar": "node scripts/run-sidecar.mjs",
    "sidecar:debug": "node scripts/run-sidecar.mjs --debug",
    "tauri:dev": "pnpm sidecar:debug && tauri dev",
    "tauri:build": "pnpm sidecar && tauri build"
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "^2.2.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-http": "^2.5.9",
    "clsx": "^2.1.1",
    "flatbuffers": "25.2.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
