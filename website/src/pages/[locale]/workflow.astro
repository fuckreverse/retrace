---
import SiteLayout from '../../layouts/SiteLayout.astro';import { isLocale,localizedPath } from '../../lib/i18n';export function getStaticPaths(){return[{params:{locale:'en'}},{params:{locale:'zh-CN'}}]};const{locale}=Astro.params;if(!isLocale(locale))return Astro.redirect('/en/');const en=locale==='en';const steps=en?[['01 / PREPARE','Choose the target and range','Resolve runtime addresses, deploy QBDITrace, and select Hook or Invoke mode.'],['02 / CAPTURE','Run the real path','Frida loads the capture engine; QBDI records instruction state and platform events into a portable trace.'],['03 / INDEX','Open in Tenet','Tenet validates the format, maps the trace, and builds or loads its persistent index.'],['04 / RECONSTRUCT','Navigate execution','Anchors and diffs reconstruct registers; write history reconstructs time-aware memory.'],['05 / EXPLAIN','Test a hypothesis','Recover CFG and calls, trace sources and sinks, identify patterns, and correlate platform semantics.'],['06 / AUTOMATE','Repeat at scale','Move a proven workflow into CLI, RPC, MCP, or streaming analysis.']]:[['01 / 准备','选择目标与范围','解析运行时地址、部署 QBDITrace，并选择 Hook 或 Invoke 模式。'],['02 / 捕获','执行真实路径','Frida 加载捕获引擎；QBDI 将指令状态和平台事件写入可移植 Trace。'],['03 / 索引','在 Tenet 中打开','Tenet 校验格式、映射 Trace，并构建或加载持久化索引。'],['04 / 重建','导航执行过程','通过锚点和差值重建寄存器，通过写历史重建时间感知内存。'],['05 / 解释','验证分析假设','恢复 CFG 和调用、追踪 source 与 sink、识别模式并关联平台语义。'],['06 / 自动化','规模化重复','将验证有效的工作流迁移到 CLI、RPC、MCP 或流式分析。']];
---
<SiteLayout locale={locale} title={`${en?'Workflow':'工作流'} — Tenet`} description={en?'From focused runtime capture to reproducible offline analysis.':'从聚焦的运行时捕获到可复现的离线分析。'}><section class="section page-hero"><div class="eyebrow">CAPTURE → RECONSTRUCT → EXPLAIN</div><h1>{en?'One evidence pipeline, end to end':'一条端到端证据链'}</h1><p>{en?'QBDITrace and Tenet share a versioned trace contract. Capture stays focused on facts; offline analysis does the expensive reconstruction and interpretation.':'QBDITrace 与 Tenet 通过版本化 Trace 契约协作。捕获端只聚焦事实，昂贵的状态重建与解释留在离线端。'}</p></section><section class="section"><div class="timeline">{steps.map(([id,title,text])=><article class="timeline-step"><code>{id}</code><div><h3>{title}</h3><p>{text}</p></div></article>)}</div><div class="actions"><a class="button primary" href={localizedPath(locale,'/docs/getting-started/')}>{en?'Follow the first-trace guide':'开始第一份 Trace 指南'} →</a></div></section></SiteLayout>
