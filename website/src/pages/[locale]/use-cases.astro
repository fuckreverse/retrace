---
import SiteLayout from '../../layouts/SiteLayout.astro';import {isLocale,localizedPath}from '../../lib/i18n';export function getStaticPaths(){return[{params:{locale:'en'}},{params:{locale:'zh-CN'}}]};const{locale}=Astro.params;if(!isLocale(locale))return Astro.redirect('/en/');const en=locale==='en';const cases=en?[['Recover a signing algorithm','Trace a real request, identify the output sink, run backward taint, and inspect constants and loop semantics along the critical path.'],['Explain mobile cryptography','Correlate CommonCrypto, BoringSSL, ObjC messages, and low-level ARX or substitution patterns with exact call-site state.'],['Understand encoded data','Follow buffers through memory writes, snapshots, entropy changes, string recovery, and precise value searches.'],['Investigate anti-analysis code','Combine executed CFGs, system calls, branch behavior, pattern rules, and trace comparison instead of relying on unreachable static paths.'],['Recover obfuscated structure','Use execution-backed functions, XRefs, CFGs, loops, and VM abstraction hints to reduce dispatcher noise.'],['Drive analysis with AI','Expose bounded trace queries and analysis passes through MCP while preserving evidence and hypothesis tracking.']]:[['还原签名算法','录制真实请求，定位输出 sink，执行反向污点，并检查关键路径上的常量与循环语义。'],['解释移动端密码学','将 CommonCrypto、BoringSSL、ObjC 消息和低层 ARX 或替换模式与准确调用点状态关联。'],['理解编码数据','沿内存写入、快照、熵变化、字符串恢复和精确值搜索追踪缓冲区。'],['调查反分析代码','结合已执行 CFG、系统调用、分支行为、模式规则与 Trace 对比，而不是依赖不可达静态路径。'],['恢复混淆结构','使用执行支撑的函数、XRef、CFG、循环与 VM 抽象提示降低分发器噪声。'],['由 AI 驱动分析','通过 MCP 暴露有边界的 Trace 查询与分析 Pass，同时保留证据和假设跟踪。']];
---
<SiteLayout locale={locale} title={`${en?'Use cases':'应用场景'} — Tenet`} description={en?'Evidence-first workflows for mobile reverse engineering and security research.':'面向移动逆向与安全研究的证据优先工作流。'}><section class="section page-hero"><div class="eyebrow">QUESTION-DRIVEN ANALYSIS</div><h1>{en?'Start from the question, not the feature list':'从问题出发，而不是从功能列表出发'}</h1><p>{en?'Tenet combines exact runtime state with structure, data flow, algorithm, and platform context so each conclusion stays connected to evidence.':'Tenet 将准确运行时状态与结构、数据流、算法和平台上下文结合，让每个结论都能回到证据。'}</p></section><section class="section"><div class="feature-grid">{cases.map(([title,text],i)=><article class="card"><span class="index">0{i+1}</span><h3>{title}</h3><p>{text}</p></article>)}</div><div class="actions"><a class="button primary" href={localizedPath(locale,'/docs/analyze/')}>{en?'Explore analysis guides':'查看分析指南'} →</a></div></section></SiteLayout>
