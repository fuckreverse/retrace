---
import SiteLayout from '../../layouts/SiteLayout.astro';import manifest from '../../data/release.json';import {isLocale,localizedPath}from '../../lib/i18n';import{formatBytes,parseReleaseManifest}from '../../lib/releases';export function getStaticPaths(){return[{params:{locale:'en'}},{params:{locale:'zh-CN'}}]};const{locale}=Astro.params;if(!isLocale(locale))return Astro.redirect('/en/');const en=locale==='en';const origin=import.meta.env.PUBLIC_DOWNLOAD_BASE_URL??'https://downloads.tenet.dev';const release=parseReleaseManifest(manifest,origin);const preview=release.channel==='preview';
---
<SiteLayout locale={locale} title={`${en?'Download':'下载'} Tenet`} description={en?'Download Tenet for macOS on Apple Silicon.':'下载适用于 Apple Silicon Mac 的 Tenet。'}><section class="section page-hero"><div class="eyebrow">TENET DESKTOP</div><h1>{en?'Download Tenet for macOS':'下载 macOS 版 Tenet'}</h1><p>{en?'The first desktop release targets Apple Silicon. Capture components for iOS and Android are deployed through the platform guides.':'首个桌面版本面向 Apple Silicon。iOS 与 Android 捕获组件通过对应平台指南部署。'}</p><p>{en?'The Tenet backend already supports Windows, Linux, and macOS on x86_64 and arm64. Desktop packages for additional platforms will follow.':'Tenet 后端已支持 Windows、Linux 和 macOS 的 x86_64 与 arm64 架构，其他平台的桌面安装包将陆续推出。'}</p></section><section class="section"><article class="download-card"><div><div class="eyebrow">MACOS / APPLE SILICON · {release.channel.toUpperCase()}</div><h2>Tenet {release.version}</h2><div class="download-meta"><span>{release.publishedAt}</span><span>{formatBytes(release.sizeBytes)}</span><span>macOS {release.minOs}+</span><span>ARM64</span></div>{preview&&<div class="notice">{en?'Preview release: this build is intended for early evaluation. See the signing and Gatekeeper notes below before installing.':'预览版本：此构建供早期体验使用。安装前请阅读下方的签名与 Gatekeeper 说明。'}</div>}<p class="mono">SHA-256</p><div class="hash">{release.sha256}</div></div><div><a class="button primary" href={release.downloadUrl} download>{en?'Download DMG':'下载 DMG'} ↓</a><p><a href={localizedPath(locale,'/docs/getting-started/install/')}>{en?'Installation guide':'安装指南'} →</a></p></div></article><aside class="notice" style="margin-top:24px"><strong>{en?'Current preview signing':'当前预览版签名说明'}</strong><p>{en?'This build is ad-hoc signed and is not notarized by Apple. Gatekeeper may block its first launch on another Mac. Move Tenet to Applications, then follow the installation guide or run the commands below in Terminal.':'此版本使用 ad-hoc 签名，且未经 Apple 公证。在其他 Mac 上首次启动时，Gatekeeper 可能会阻止运行。请先将 Tenet 移入“应用程序”，再按照安装指南操作，或在终端执行以下命令。'}</p><div class="hash">xattr -dr com.apple.quarantine /Applications/Tenet.app<br />open /Applications/Tenet.app</div><p><a href={localizedPath(locale,'/docs/getting-started/install/')}>{en?'Read the Gatekeeper installation steps':'查看 Gatekeeper 安装步骤'} →</a></p></aside><p class="lead" style="margin-top:24px">{en?'Complete third-party notices and license texts are included in every Tenet application bundle.':'每份 Tenet 应用包均随附完整的第三方声明和许可证文本。'} <a href={localizedPath(locale,'/third-party-notices/')}>{en?'Review third-party software':'查看第三方软件声明'} →</a></p><h2 style="margin-top:64px">{en?'Other platforms':'其他平台'}</h2><div class="feature-grid"><article class="card planned"><span class="index">{en?'BACKEND READY · DESKTOP PACKAGE IN PROGRESS':'后端已支持 · 桌面安装包制作中'}</span><h3>macOS Intel</h3></article><article class="card planned"><span class="index">{en?'BACKEND READY · DESKTOP PACKAGE IN PROGRESS':'后端已支持 · 桌面安装包制作中'}</span><h3>Linux</h3></article><article class="card planned"><span class="index">{en?'BACKEND READY · DESKTOP PACKAGE IN PROGRESS':'后端已支持 · 桌面安装包制作中'}</span><h3>Windows</h3><p>{en?'CLI, TUI, RPC, and MCP are available. Live desktop browsing over WebSocket is temporarily unavailable on Windows.':'CLI、TUI、RPC 与 MCP 均可用；Windows 上暂不支持桌面应用通过 WebSocket 实时浏览。'}</p></article></div></section></SiteLayout>
