---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import TraceInstrument from '../../../components/TraceInstrument.astro';
import { isLocale, localizedPath } from '../../../lib/i18n';
export function getStaticPaths(){return ['en','zh-CN'].flatMap(locale=>['capture','analysis'].map(product=>({params:{locale,product}})));}
const { locale, product }=Astro.params;if(!isLocale(locale))return Astro.redirect('/en/');const en=locale==='en';const capture=product==='capture';
const data=capture?{eyebrow:'QBDITRACE / CAPTURE ENGINE',title:en?'Runtime truth, captured at instruction level':'指令级捕获真实运行过程',intro:en?'QBDITrace uses QBDI and Frida to record a focused execution range on iOS or Android without putting disassembly or symbol work on the hot path.':'QBDITrace 基于 QBDI 与 Frida，在 iOS 或 Android 上记录聚焦执行范围，并将反汇编和符号化移出运行期热路径。'}:{eyebrow:'TENET / OFFLINE ANALYSIS',title:en?'Reconstruct execution. Investigate without time pressure.':'重建执行过程，不受时间限制地深入分析',intro:en?'Tenet turns a portable trace into a navigable timeline with state reconstruction, structure recovery, data-flow analysis, and platform-aware semantics.':'Tenet 将可移植 Trace 变成可导航时间轴，提供状态重建、结构恢复、数据流分析与平台感知语义。'};
const facts=capture?(en?[['RECORDS','Instructions, GPR diffs, NZCV, memory, SVC, ObjC, C APIs, embedded code'],['TARGETS','iOS AArch64 and Android AArch64'],['EXECUTION','Current-thread QBDI VM with out-of-range native execution'],['FORMAT','Versioned binary contract with optional PC delta, FPR, and zstd compression']]:[['记录内容','指令、GPR 差值、NZCV、内存、SVC、ObjC、C API 与内嵌码表'],['目标平台','iOS AArch64 与 Android AArch64'],['执行模型','当前线程由 QBDI VM 接管，范围外原生执行'],['格式','版本化二进制契约，可选 PC delta、FPR 与 zstd 压缩']]):(en?[['NAVIGATE','Timeline, history, breakpoints, searches, XRefs, and call stacks'],['REBUILD','Registers at any instruction and time-aware memory'],['ANALYZE','CFG, call graph, taint, critical path, patterns, loops, and algorithms'],['INTEGRATE','IDA two-way navigation, CLI, JSON-RPC, MCP Hub on 10444, and streaming index']]:[['导航','时间轴、历史、断点、搜索、XRef 与调用栈'],['重建','任意指令点寄存器与时间感知内存'],['分析','CFG、调用图、污点、关键路径、模式、循环与算法'],['集成','IDA 双向导航、CLI、JSON-RPC、10444 MCP Hub 与流式索引']]);
---
<SiteLayout locale={locale} title={`${data.title} — Tenet`} description={data.intro}><section class="section page-hero"><div class="eyebrow">{data.eyebrow}</div><h1>{data.title}</h1><p>{data.intro}</p><div class="actions"><a class="button primary" href={localizedPath(locale,capture?'/docs/capture/':'/docs/analyze/')}>{en?'Read the guide':'阅读指南'} →</a><a class="button" href={localizedPath(locale,'/workflow/')}>{en?'See the workflow':'查看工作流'}</a></div></section><section class="section split"><div><div class="eyebrow">CAPABILITIES</div><h2>{capture?(en?'Designed around a minimal hot path':'围绕最小热路径设计'):(en?'One trace, multiple levels of explanation':'一份 Trace，多层次解释')}</h2><p class="lead">{capture?(en?'Per-thread buffers and an asynchronous writer keep runtime work focused on recording facts. Embedded instruction bytes make traces self-contained for offline disassembly.':'每线程缓冲与异步 writer 让运行期只聚焦记录事实；内嵌指令字节让 Trace 可独立完成离线反汇编。'):(en?'Start with exact instruction state, recover program structure, follow values through the execution, then connect the evidence to platform and algorithm semantics.':'从准确指令状态出发，恢复程序结构、追踪值在执行中的传播，再将证据关联到平台与算法语义。')}</p></div><div class="fact-list">{facts.map(([label,value])=><div class="fact"><b>{label}</b><span>{value}</span></div>)}</div></section>{!capture&&<section class="section"><TraceInstrument /></section>}</SiteLayout>
