const content = locale === 'en' ? english : chinese;
---

<SiteLayout locale={locale} title={`${content.metaTitle} — Tenet`} description={content.description}>
  <section class="section page-hero terms-hero">
    <div class="eyebrow">{content.eyebrow}</div>
    <h1>{content.title}</h1>
    <p>{content.intro}</p>
    <div class="terms-dates mono">
      <span>{content.effective}: {content.date}</span>
      <span>{content.updated}: {content.date}</span>
    </div>
  </section>

  <main class="section terms-shell">
    <aside class="terms-summary" aria-labelledby="terms-summary-title">
      <div class="summary-label mono" id="terms-summary-title">{content.summaryTitle}</div>
      {content.summaries.map(([label, text]) => (
        <div class="summary-item">
          <strong class="mono">{label}</strong>
          <span>{text}</span>
        </div>
      ))}
      <p class="language-note">{content.languageNote}</p>
    </aside>

    <article class="terms-document">
      {content.sections.map((section) => (
        <section class="terms-section" id={`section-${section.number}`}>
          <header>
            <span class="section-number mono">{section.number}</span>
            <h2>{section.title}</h2>
          </header>
          {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          {'bullets' in section && section.bullets && (
            <ul>{section.bullets.map((item) => <li>{item}</li>)}</ul>
          )}
          {'note' in section && section.note && <div class="terms-callout">{section.note}</div>}
          {'link' in section && section.link && <a class="terms-link" href={section.link.href}>{section.link.label} →</a>}
        </section>
      ))}
      <div class="notice legal-review">{content.review}</div>
    </article>
  </main>
</SiteLayout>

<style>
  .terms-hero { padding-bottom: 54px; }
  .terms-dates { display: flex; flex-wrap: wrap; gap: 12px 28px; margin-top: 28px; color: var(--faint); font-size: 11px; letter-spacing: .04em; }
  .terms-shell { display: grid; grid-template-columns: 280px minmax(0, 760px); justify-content: space-between; gap: 72px; align-items: start; }
  .terms-summary { position: sticky; top: 28px; border: 1px solid var(--line); border-radius: 8px; background: var(--panel); padding: 22px; }
  .summary-label { margin-bottom: 18px; color: var(--accent); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; }
  .summary-item { display: grid; gap: 4px; padding: 14px 0; border-top: 1px solid var(--line); }
  .summary-item strong { color: var(--text); font-size: 10px; letter-spacing: .1em; }
  .summary-item span, .language-note { color: var(--muted); font-size: 13px; line-height: 1.55; }
  .language-note { margin: 18px 0 0; padding-top: 16px; border-top: 1px solid var(--line); }
  .terms-document { min-width: 0; }
  .terms-section { scroll-margin-top: 24px; padding: 0 0 44px; margin: 0 0 44px; border-bottom: 1px solid var(--line); }
  .terms-section header { display: grid; grid-template-columns: 42px 1fr; align-items: baseline; gap: 10px; margin-bottom: 20px; }
  .section-number { color: var(--accent); font-size: 11px; }
  .terms-section h2 { margin: 0; font-size: clamp(22px, 2.6vw, 30px); letter-spacing: -.025em; }
  .terms-section p, .terms-section li { color: var(--muted); font-size: 15px; line-height: 1.8; }
  .terms-section p { margin: 0 0 16px; }
  .terms-section ul { margin: 8px 0 18px 18px; padding: 0; }
  .terms-section li { padding-left: 8px; margin: 8px 0; }
  .terms-section li::marker { color: var(--accent); }
  .terms-callout { margin-top: 20px; padding: 16px 18px; border-left: 2px solid var(--accent); background: var(--accent-dim); color: var(--text); font-size: 14px; }
  .terms-link { display: inline-flex; margin-top: 2px; color: var(--accent); border-bottom: 1px solid transparent; font-size: 14px; }
  .terms-link:hover { border-bottom-color: var(--accent); }
  .legal-review { margin: 0; }
  @media (max-width: 850px) {
    .terms-shell { grid-template-columns: 1fr; gap: 48px; }
    .terms-summary { position: static; }
    .terms-section { padding-bottom: 34px; margin-bottom: 34px; }
  }
</style>
