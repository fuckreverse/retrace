---
import SiteLayout from '../../layouts/SiteLayout.astro';import manifest from '../../data/release.json';import{isLocale}from '../../lib/i18n';export function getStaticPaths(){return[{params:{locale:'en'}},{params:{locale:'zh-CN'}}]};const{locale}=Astro.params;if(!isLocale(locale))return Astro.redirect('/en/');const en=locale==='en';
---
<SiteLayout locale={locale} title={`${en?'Release notes':'版本说明'} — Tenet`} description={en?'Tenet release notes and compatibility changes.':'Tenet 版本变更与兼容性说明。'}><section class="section page-hero"><div class="eyebrow">RELEASE NOTES</div><h1>{en?'What changed':'版本变化'}</h1><p>{en?'Version history, format compatibility, and migration notes for Tenet Desktop.':'Tenet Desktop 的版本历史、格式兼容性与迁移说明。'}</p></section><section class="section"><article class="card"><span class="index">{manifest.publishedAt} · {manifest.channel.toUpperCase()}</span><h2>{manifest.version}</h2><p>{en?'Initial website preview channel for macOS Apple Silicon distribution. The download artifact must be signed, notarized, uploaded to the immutable R2 object key, and verified before public release.':'面向 macOS Apple Silicon 分发的首个网站预览通道。公开发布前，下载产物必须完成签名、公证，上传至不可变 R2 对象路径并通过校验。'}</p></article></section></SiteLayout>
