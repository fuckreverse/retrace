---
import SiteLayout from '../../layouts/SiteLayout.astro';import manifest from '../../data/release.json';import{isLocale}from '../../lib/i18n';export function getStaticPaths(){return[{params:{locale:'en'}},{params:{locale:'zh-CN'}}]};const{locale}=Astro.params;if(!isLocale(locale))return Astro.redirect('/en/');const en=locale==='en';
---
<SiteLayout locale={locale} title={`${en?'Release notes':'版本说明'} — Tenet`} description={en?'Tenet release notes and compatibility changes.':'Tenet 版本变更与兼容性说明。'}><section class="section page-hero"><div class="eyebrow">RELEASE NOTES</div><h1>{en?'What changed':'版本变化'}</h1><p>{en?'Version history, format compatibility, and migration notes for Tenet Desktop.':'Tenet Desktop 的版本历史、格式兼容性与迁移说明。'}</p></section><section class="section"><article class="card"><span class="index">{manifest.publishedAt} · {manifest.channel.toUpperCase()}</span><h2>{manifest.version}</h2><p>{en?"Tenet Desktop's first public preview release. This preview currently provides a DMG only for macOS Apple Silicon (ARM64). The DMG is ad-hoc signed and is not notarized by Apple, so Gatekeeper may show a warning on first launch.":'Tenet Desktop 的首个公开预览版本。当前预览版仅提供适用于 macOS Apple Silicon（ARM64）的 DMG。该 DMG 使用 ad-hoc 签名且未经 Apple 公证，因此首次启动时 Gatekeeper 可能会显示警告。'}</p></article></section></SiteLayout>
