---
import SiteLayout from '../../layouts/SiteLayout.astro';import{isLocale}from '../../lib/i18n';export function getStaticPaths(){return[{params:{locale:'en'}},{params:{locale:'zh-CN'}}]};const{locale}=Astro.params;if(!isLocale(locale))return Astro.redirect('/en/');const en=locale==='en';
---
<SiteLayout locale={locale} title={`${en?'Privacy':'隐私'} — Tenet`} description={en?'Tenet website privacy practices.':'Tenet 网站隐私实践。'}><section class="section page-hero"><div class="eyebrow">PRIVACY</div><h1>{en?'Your traces stay yours':'你的 Trace 始终属于你'}</h1><p>{en?'This website does not upload, inspect, or process trace files. Tenet Desktop performs analysis locally.':'本网站不会上传、检查或处理 Trace 文件。Tenet Desktop 在本地完成分析。'}</p></section><section class="section split"><div><h2>{en?'Website analytics':'网站分析'}</h2><p class="lead">{en?'When configured, privacy-preserving Cloudflare Web Analytics provides aggregate traffic and performance metrics without cross-site identifiers.':'配置后，Cloudflare Web Analytics 仅提供不含跨站标识的聚合流量与性能指标。'}</p></div><div><h2>{en?'Downloads':'下载'}</h2><p class="lead">{en?'The download service may retain standard infrastructure logs needed for security, reliability, and aggregate download counts.':'下载服务可能保留安全、可靠性和聚合下载量所需的标准基础设施日志。'}</p></div></section></SiteLayout>
